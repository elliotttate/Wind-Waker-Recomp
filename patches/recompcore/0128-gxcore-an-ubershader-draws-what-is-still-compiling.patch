+      for (uint32_t t = 0; t < 8u; ++t) {
+        entries[2u * t] = WGPUBindGroupEntry{.binding = 2u * t, .textureView = views[t]};
+        entries[2u * t + 1u] = WGPUBindGroupEntry{.binding = 2u * t + 1u, .sampler = samplers[t].Get()};
+      }
