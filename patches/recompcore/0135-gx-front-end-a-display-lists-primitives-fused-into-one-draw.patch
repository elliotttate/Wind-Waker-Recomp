     std::uint32_t active_mask = 0;
     for (std::uint32_t i = 0; i < kArrayCount; ++i) {
       if (arrays_[i].base_valid && arrays_[i].stride_valid)
@@ -222,6 +268,7 @@ bool ConsumingAuroraRenderSink::submit_packet(const RenderPacket& packet) {
