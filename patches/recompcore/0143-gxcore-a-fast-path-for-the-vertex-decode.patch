 GXRuntime/graphics/gxcore/src/gxcore.cpp | 546 +++++++++++++++++------
 1 file changed, 404 insertions(+), 142 deletions(-)

diff --git a/GXRuntime/graphics/gxcore/src/gxcore.cpp b/GXRuntime/graphics/gxcore/src/gxcore.cpp
index a07b7ee5..98b52b9f 100644
--- a/GXRuntime/graphics/gxcore/src/gxcore.cpp
+++ b/GXRuntime/graphics/gxcore/src/gxcore.cpp
@@ -572,6 +572,230 @@ const ar::ConsumedArrayInput* find_array(const ar::ConsumedDraw& draw,
   return nullptr;
