+// --- The vertex decode's fast path ---------------------------------------------
+//
+// build_draw_plan_into's vertex loop interprets the walk for every element of
+// every vertex: the entry's kind, its index width, its format per component,
+// the array lookup and the payload bounds, each a branch (a third of the GX
+// worker's busy time at the sea, 2026-10-05). For the common draws this
+// decodes the same values once each entry is reduced to an op: the format and
+// component count in one code, the array's base, stride and last valid
+// offset, the payload's bounds checked once for the draw. A draw it does not
+// take (normal+binormal+tangent, an unknown format, an unresolved array, a
+// payload too short) or an index out of its array's bounds returns false, and
+// the interpreting loop decodes the draw as before, with its counters.
+// DOL_GXCORE_FAST_DECODE=0 leaves every draw to that loop; =verify decodes
+// each draw both ways and reports a difference (debug).
+struct FastOp {
+  enum Code : std::uint8_t {
+    kPosMtx,  // the PNMTXIDX byte
+    kTexMtx,  // a TEXMTXIDX byte, for texgen `aux`
+    kSkip,    // an attribute this layout has no room for: consumed only
+    kColor,   // a colour of format `aux`
+    kComps,   // `count` components of format `aux`, times `scale`
+  };
+  Code code = kSkip;
+  std::uint8_t aux = 0;
+  std::uint8_t count = 0;
+  std::uint8_t index = 0;   // 0 direct, 1 an 8-bit index, 2 a 16-bit one
+  std::uint32_t advance = 0; // payload bytes the entry takes
+  std::uint32_t dst = 0;     // the output's first float in the vertex
+  const std::uint8_t* base = nullptr;
+  std::uint32_t stride = 0;
+  std::uint32_t last = 0;    // the last offset an element may start at
+  float scale = 1.f;
+};
+
+template <std::uint32_t Format>
+inline float fast_component(const std::uint8_t* p, float scale) {
+  if constexpr (Format == 0u)
+    return static_cast<float>(p[0]) * scale;
+  else if constexpr (Format == 1u)
+    return static_cast<float>(static_cast<std::int8_t>(p[0])) * scale;
+  else if constexpr (Format == 2u)
+    return static_cast<float>(load_be16(p)) * scale;
+  else if constexpr (Format == 3u)
+    return static_cast<float>(static_cast<std::int16_t>(load_be16(p))) * scale;
+  else {
+    const std::uint32_t v = load_be32(p);
+    float f;
+    std::memcpy(&f, &v, sizeof f);
+    return f;
+  }
+}
+
+template <std::uint32_t Format>
+inline void fast_components(const std::uint8_t* p, std::uint32_t count, float scale, float* dst) {
+  constexpr std::uint32_t size = Format <= 1u ? 1u : Format <= 3u ? 2u : 4u;
+  dst[0] = fast_component<Format>(p, scale);
+  if (count > 1u)
+    dst[1] = fast_component<Format>(p + size, scale);
+  if (count > 2u)
+    dst[2] = fast_component<Format>(p + 2u * size, scale);
+}
+
+const std::array<float, 256>& unorm8_table() {
+  static const auto table = [] {
+    std::array<float, 256> t{};
+    for (std::uint32_t i = 0; i < 256u; ++i)
+      t[i] = static_cast<float>(i) / 255.f;
+    return t;
+  }();
+  return table;
+}
+
+// The draw's vertices into `out` (zeroed, vertex_count * vertex_floats), as
+// the interpreting loop makes them; false to leave the draw to it.
+bool decode_vertices_fast(const WalkLayout& walk, const ar::ConsumedDraw& draw,
+                          const ar::ConsumedArrayInput* const entry_arrays[24], const float entry_scales[24],
+                          bool full_layout, std::uint32_t vertex_floats, float* out) {
+  if (walk.has_nbt || walk.entry_count > 24u ||
+      static_cast<std::uint64_t>(draw.vertex_count) * walk.vertex_size > draw.vertex_payload.size())
+    return false;
+  FastOp ops[24];
+  std::uint32_t normals = 0;
+  for (std::uint32_t e = 0; e < walk.entry_count; ++e) {
+    const WalkEntry& entry = walk.entries[e];
+    FastOp& op = ops[e];
+    if (entry.kind == WalkEntry::kPosMtxIdx || entry.kind == WalkEntry::kTexMtxIdx) {
+      op.code = entry.kind == WalkEntry::kPosMtxIdx ? FastOp::kPosMtx : FastOp::kTexMtx;
+      op.aux = entry.out_slot;
+      op.advance = 1u;
+      continue;
+    }
+    if (entry.vcd_type == 1u) {
+      op.advance = entry.element_size;
+    } else {
+      const ar::ConsumedArrayInput* array = entry_arrays[e];
+      if (array == nullptr || !array->resolved || array->host_data == nullptr ||
+          array->host_available < entry.element_size)
+        return false;
+      op.index = entry.vcd_type == 2u ? 1u : 2u;
+      op.advance = op.index;
+      op.base = static_cast<const std::uint8_t*>(array->host_data);
+      op.stride = array->stride;
+      op.last = array->host_available - entry.element_size;
+    }
+    op.scale = entry_scales[e];
+    switch (entry.kind) {
+    case WalkEntry::kPos:
+      if (entry.format > 4u || entry.count < 1u || entry.count > 3u)
+        return false;
+      op.code = FastOp::kComps;
+      op.aux = entry.format;
+      op.count = entry.count;
+      op.dst = kVertexPosOffset / 4u;
+      break;
+    case WalkEntry::kNormal:
+      if (entry.format > 4u || entry.count != 3u || ++normals > 1u)
+        return false;
+      op.code = FastOp::kComps;
+      op.aux = entry.format;
+      op.count = 3u;
+      op.dst = kVertexNormalOffset / 4u;
+      break;
+    case WalkEntry::kColor:
+      if (entry.format > 5u)
+        return false;
+      if (entry.out_slot == 0u || full_layout) {
+        op.code = FastOp::kColor;
+        op.aux = entry.format;
+        op.dst = (entry.out_slot == 0u ? kVertexColor0Offset : kVertexColor1Offset) / 4u;
+      }
+      break;
+    case WalkEntry::kTex:
+      if (entry.format > 4u || entry.count < 1u || entry.count > 2u)
+        return false;
+      if (entry.out_slot < kMaxTexGens && (entry.out_slot < 2u || full_layout)) {
+        op.code = FastOp::kComps;
+        op.aux = entry.format;
+        op.count = entry.count;
+        op.dst = vertex_uv_offset(entry.out_slot) / 4u;
+      }
+      break;
+    default:
+      return false;
+    }
+  }
+  const std::array<float, 256>& unorm8 = unorm8_table();
+  const std::uint8_t* payload = draw.vertex_payload.data();
+  const std::uint32_t entry_count = walk.entry_count;
+  const std::uint32_t default_row = draw.current_pn_matrix * 3u;
+  for (std::uint32_t v = 0; v < draw.vertex_count; ++v) {
+    float* const vertex = out + static_cast<std::size_t>(v) * vertex_floats;
+    float* const color0 = vertex + kVertexColor0Offset / 4u;
+    color0[0] = color0[1] = color0[2] = color0[3] = 1.f;
+    if (full_layout) {
+      float* const color1 = vertex + kVertexColor1Offset / 4u;
+      color1[0] = color1[1] = color1[2] = color1[3] = 1.f;
+    }
+    std::uint32_t posmtx_row = default_row;
+    std::uint32_t texmtx_lo = 0;
+    std::uint32_t texmtx_hi = 0;
+    const std::uint8_t* p = payload + static_cast<std::size_t>(v) * walk.vertex_size;
+    for (std::uint32_t e = 0; e < entry_count; ++e) {
+      const FastOp& op = ops[e];
+      if (op.code == FastOp::kPosMtx) {
+        posmtx_row = p[0];
+        p += 1;
+        continue;
+      }
+      if (op.code == FastOp::kTexMtx) {
+        if (op.aux < 4u)
+          texmtx_lo |= static_cast<std::uint32_t>(p[0]) << (8u * op.aux);
+        else if (op.aux < 8u)
+          texmtx_hi |= static_cast<std::uint32_t>(p[0]) << (8u * (op.aux - 4u));
+        p += 1;
+        continue;
+      }
+      const std::uint8_t* element = p;
+      if (op.index != 0u) {
+        const std::uint32_t index = op.index == 1u ? p[0] : load_be16(p);
+        const std::uint64_t offset = static_cast<std::uint64_t>(index) * op.stride;
+        if (offset > op.last)
+          return false;
+        element = op.base + offset;
+      }
+      p += op.advance;
+      float* const dst = vertex + op.dst;
+      switch (op.code) {
+      case FastOp::kComps:
+        switch (op.aux) {
+        case 0u: fast_components<0u>(element, op.count, op.scale, dst); break;
+        case 1u: fast_components<1u>(element, op.count, op.scale, dst); break;
+        case 2u: fast_components<2u>(element, op.count, op.scale, dst); break;
+        case 3u: fast_components<3u>(element, op.count, op.scale, dst); break;
+        default: fast_components<4u>(element, op.count, op.scale, dst); break;
+        }
+        break;
+      case FastOp::kColor:
+        if (op.aux == 5u) { // RGBA8888
+          dst[0] = unorm8[element[0]];
+          dst[1] = unorm8[element[1]];
+          dst[2] = unorm8[element[2]];
+          dst[3] = unorm8[element[3]];
+        } else if (op.aux == 1u || op.aux == 2u) { // RGB888, RGB888x
+          dst[0] = unorm8[element[0]];
+          dst[1] = unorm8[element[1]];
+          dst[2] = unorm8[element[2]];
+          dst[3] = 1.f;
+        } else {
+          decode_color(element, op.aux, dst);
+        }
+        break;
+      default:
+        break;
+      }
+    }
+    std::memcpy(vertex + kVertexPosMtxOffset / 4u, &posmtx_row, sizeof posmtx_row);
+    if (full_layout) {
+      std::memcpy(vertex + kVertexTexMtxIdxOffset / 4u, &texmtx_lo, sizeof texmtx_lo);
+      std::memcpy(vertex + kVertexTexMtxIdxHiOffset / 4u, &texmtx_hi, sizeof texmtx_hi);
+    }
+  }
+  return true;
+}
