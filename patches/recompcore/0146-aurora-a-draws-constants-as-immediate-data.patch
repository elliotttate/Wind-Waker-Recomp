+// What the render worker hands Dawn encoding passes, and the time it takes,
+// for DOL_AURORA_ENCODE_STATS's [encode-stats] lines (per game frame).
+struct EncodeStats {
+  uint64_t passes = 0;
+  uint64_t draws = 0;
+  uint64_t group1 = 0;
+  uint64_t group2 = 0;
